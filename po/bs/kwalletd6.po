#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "Nije pronađen nijedan odgovarajući GPG ključ za šifriranje. Da biste ga napravili, izaberite jednu od sljedećih opcija:<list><item>Instalirajte Kleopatru i pomoću nje napravite novi ključ. Pogledajte ova <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>uputstva</link>.</item><item>Otvorite terminal i unesite <command>gpg --full-gen-key</command>.</item><item>Vratite se nazad i umjesto toga koristite Blowfish šifriranje, koje zahtijeva samo šifru.</item></list>"

