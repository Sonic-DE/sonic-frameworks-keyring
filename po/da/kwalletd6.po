#, kde-format
msgid ""
"The GpgME library failed to initialize for the OpenPGP protocol. Please "
"check your system's configuration then try again."
msgstr ""
"Biblioteket GpgME kunne ikke starte OpenPGP-protokollen. Tjek din "
"systemkonfiguration og prøv igen."

#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "Der blev ikke fundet nogen egnede GPG-krypteringsnøgler. For at oprette en skal du vælge en af følgende muligheder:<list><item>Installér Kleopatra og brug det til at oprette en ny nøgle. Se denne <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>vejledning</link>.</item><item>Åbn en terminal og indtast <command>gpg --full-gen-key</command>.</item><item>Gå tilbage og brug Blowfish-kryptering i stedet, som kun kræver en adgangskode.</item></list>"

