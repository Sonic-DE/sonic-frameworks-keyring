#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr ""
"Felëje pasownëch kluczów szifrowaniô GPG. Bë ùsadzëc klucz, wëbierzë jednã z "
"nôslédnëch mòżnotów:<list><item>Wjinstalëjë Kleopatrã ë ùsadzë w ni nowi "
"klucz. Òbôczë te <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>pòrénczi</link>.</item><item>Òtemkni "
"terminal ë wpiszë <command>gpg --full-gen-key</command>.</item><item>Wrócë "
"nazôd ë brëkùj nôwczas szifrowaniô Blowfish, chtërno wëmôgô leno parolë.</"
"item></list>"

