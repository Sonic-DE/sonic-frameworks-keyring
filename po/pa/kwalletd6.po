#: ksecretd/ksecretd.cpp:861
#, kde-format
msgid ""
"Unable to open wallet. The wallet must be opened in order to change the "
"password."
msgstr "ਵਾਲਟ ਖੋਲ੍ਹਣ ਲਈ ਅਸਮੱਰਥ ਹੈ। ਪਾਸਵਰਡ ਬਦਲਣ ਲਈ ਵਾਲਟ ਨੂੰ ਖੋਲ੍ਹਣ ਲਾਜ਼ਮੀ ਹੈ।"

#: ksecretd/ksecretd.cpp:588
#, kde-format
msgid ""
"<qt>The <b>%1</b> wallet is encrypted using GPG key <b>%2</b>. Please use "
"<b>GPG</b> tools to change the passphrase associated to that key.</qt>"
msgstr "<qt><b>%1</b> ਵਾਲਟ GPG ਕੁੰਜੀ <b>%2</b> ਨਾਲ ਇੰਕ੍ਰਿਪਟ ਕੀਤਾ ਹੋਇਆ ਹੈ। ਉਸ ਕੁੰਜੀ ਨਾਲ ਸੰਬੰਧਿਤ ਵਾਕ-ਪਾਸਵਰਡ ਬਦਲਣ ਲਈ <b>GPG</b> ਟੂਲ ਵਰਤੋ ਜੀ।</qt>"

#: ksecretd/ksecretd.cpp:884
#, kde-format
msgid "<qt>Please choose a new password for the wallet '<b>%1</b>'.</qt>"
msgstr "<qt>ਵਾਲਟ '<b>%1</b>' ਲਈ ਨਵਾਂ ਪਾਸਵਰਡ ਚੁਣੋ ਜੀ।</qt>"

#: ksecretd/ksecretd.cpp:896
#, kde-format
