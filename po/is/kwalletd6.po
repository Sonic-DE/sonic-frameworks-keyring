#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "Engir hentugir GPG-dulritunarlyklar fundust. Til að búa til lykil skaltu velja einn af eftirfarandi kostum:<list><item>Settu upp Kleopatra og notaðu það til að búa til nýjan lykil. Skoðaðu þessar <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>leiðbeiningar</link>.</item><item>Opnaðu skjáhermi og sláðu inn <command>gpg --full-gen-key</command>.</item><item>Farðu til baka og notaðu frekar Blowfish-dulritun, sem þarf einungis lykilorð.</item></list>"

