#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "ಸೂಕ್ತವಾದ GPG ಗೂಢಲಿಪೀಕರಣ ಕೀಲಿಗಳು ಕಂಡುಬಂದಿಲ್ಲ. ಒಂದನ್ನು ರಚಿಸಲು, ಈ ಕೆಳಗಿನ ಆಯ್ಕೆಗಳಲ್ಲಿ ಒಂದನ್ನು ಆರಿಸಿ:<list><item>Kleopatra ಅನ್ನು ಅನುಸ್ಥಾಪಿಸಿ ಮತ್ತು ಅದನ್ನು ಬಳಸಿ ಹೊಸ ಕೀಲಿಯನ್ನು ರಚಿಸಿ. ಈ <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>ಸೂಚನೆಗಳನ್ನು</link> ನೋಡಿ.</item><item>ಟರ್ಮಿನಲ್ ತೆರೆದು <command>gpg --full-gen-key</command> ಅನ್ನು ನಮೂದಿಸಿ.</item><item>ಹಿಂದಕ್ಕೆ ಹೋಗಿ ಬದಲಿಗೆ Blowfish ಗೂಢಲಿಪೀಕರಣವನ್ನು ಬಳಸಿ, ಇದಕ್ಕೆ ಗುಪ್ತಪದ ಮಾತ್ರ ಬೇಕು.</item></list>"

