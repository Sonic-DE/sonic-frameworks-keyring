msgstr "<qt>KDE ਨੇ ਖੁੱਲ੍ਹੇ ਵਾਲਟ '<b>%1</b>' ਵਰਤਣ ਦੀ ਮੰਗ ਕੀਤੀ ਹੈ।</qt>"

#: ksecretd/ksecretd.cpp:753
#, kde-format
msgid ""
"<qt>The application '<b>%1</b>' has requested access to the open wallet '<b>"
