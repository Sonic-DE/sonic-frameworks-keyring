#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr ""
"Et goufe keng passend GPG-Verschlësselungsschlësselen fonnt. Fir een "
"unzeleeën, wielt eng vun dëse Méiglechkeeten:<list><item>Installéiert "
"Kleopatra a leet domat en neie Schlëssel un. Kuckt dës <link url='https://"
"docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-"
"newkey.html'>Uweisungen</link>.</item><item>Maacht en Terminal op a gitt "
"<command>gpg --full-gen-key</command> an.</item><item>Gitt zréck a benotzt "
"amplaz d'Blowfish-Verschlësselung, déi just e Passwuert brauch.</item></list>"

