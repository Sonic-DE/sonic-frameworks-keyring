#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr ""
"Ii gávdnon heivvolaš GPG-krypterenčoavdda. Jus háliidat ráhkadit dakkára, "
"vállje ovtta dáin molssaeavttuin:<list><item>Sajáiduhte Kleopatra ja ráhkat "
"dainna ođđa čoavdaga. Geahča dáid <link url='https://docs.kde.org/stable_kf6/"
"en/kleopatra/kleopatra/functions-newkey.html'>rávvagiid</link>.</"
"item><item>Raba terminála ja čális <command>gpg --full-gen-key</command>.</"
"item><item>Mana ruovttoluotta ja geavat baicca Blowfish-krypterema, mii "
"gáibida dušše beassansáni.</item></list>"

