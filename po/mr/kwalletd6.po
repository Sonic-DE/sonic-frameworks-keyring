#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "कोणतीही योग्य GPG एन्क्रिप्शन किल्ली सापडली नाही. एक तयार करण्यासाठी, खालीलपैकी एक पर्याय निवडा:<list><item>Kleopatra स्थापित करा आणि त्याद्वारे नवीन किल्ली तयार करा. या <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>सूचना</link> पहा.</item><item>टर्मिनल उघडा आणि <command>gpg --full-gen-key</command> प्रविष्ट करा.</item><item>मागे जा आणि त्याऐवजी केवळ परवलीचा शब्द लागणारे Blowfish एन्क्रिप्शन वापरा.</item></list>"

