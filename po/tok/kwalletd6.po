#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr ""
"ilo open len GPG pona li lon ala. sina wile pali e ona la, o kepeken e nasin "
"wan:<list><item>o pana e ilo Kleopatra, o pali e ilo open sin kepeken ona. o "
"lukin e <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/"
"functions-newkey.html'>lipu nasin</link> ni.</item><item>o open e ilo toki, "
"o sitelen e <command>gpg --full-gen-key</command>.</item><item>o tawa monsi, "
"o kepeken len Blowfish. ona li wile e nimi len taso.</item></list>"

