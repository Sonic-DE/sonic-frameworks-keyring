#: ksecretd/knewwalletdialog.cpp:176
#, kde-kuit-format
msgctxt "@info"
msgid ""
"No suitable GPG encryption keys were found. To create one, choose one of the "
"following options:<list><item>Install Kleopatra and use it to create a new "
"key. See these <link url='https://docs.kde.org/stable_kf6/en/kleopatra/"
"kleopatra/functions-newkey.html'>instructions</link>.</item><item>Open a "
"terminal and enter <command>gpg --full-gen-key</command>.</item><item>Go "
"back and use Blowfish encryption instead, which only requires a password.</"
"item></list>"
msgstr "അനുയോജ്യമായ GPG എൻക്രിപ്ഷൻ താക്കോലുകളൊന്നും കണ്ടെത്തിയില്ല. ഒന്ന് ഉണ്ടാക്കാൻ, താഴെയുള്ള ഓപ്ഷനുകളിൽ ഒന്ന് തിരഞ്ഞെടുക്കുക:<list><item>Kleopatra ഇൻസ്റ്റാൾ ചെയ്ത് അത് ഉപയോഗിച്ച് ഒരു പുതിയ താക്കോൽ ഉണ്ടാക്കുക. ഈ <link url='https://docs.kde.org/stable_kf6/en/kleopatra/kleopatra/functions-newkey.html'>നിർദ്ദേശങ്ങൾ</link> കാണുക.</item><item>ഒരു ടെർമിനൽ തുറന്ന് <command>gpg --full-gen-key</command> നൽകുക.</item><item>പിന്നോട്ട് പോയി, അടയാളവാക്ക് മാത്രം ആവശ്യമുള്ള Blowfish എൻക്രിപ്ഷൻ പകരം ഉപയോഗിക്കുക.</item></list>"

